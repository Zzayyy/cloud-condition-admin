# 开发环境
VITE_PORT=5173
# 后端服务地址（后端已落地：cloud-condition-admin/backend，默认 8000 端口，上下文 /api）
VITE_API_TARGET=http://127.0.0.1:8000

# 演示数据开关：
#   true  = 直接用 src/api/mock/ 下的假数据渲染页面（后端未就绪时用来看效果）
#   false = 走真实接口；后端不可达时仍会自动降级并给出提示
#
# 2026-10-12：后端「系统管理」三个页面已实现，这里改为 false 走真实接口。
#   ⚠️ 改本文件后必须**重启 Vite** 才生效（env 是构建期注入的，热更新不会重读）。
#   ⚠️ 降级只在开发环境生效，且仅限「连不上」；业务错误码不会降级
#      （生产环境后端故障时宁可报错，也不拿假数据盖住，见 README 的三条安全约束）。
VITE_USE_MOCK=false

# 开发服务器的 Host 白名单（逗号分隔），给内网穿透用。
# 不填则用 vite.config.ts 里的默认值（常见穿透服务的通配符）。
# 以 "." 开头 = 匹配该域名本身 + 任意子域。
# natapp 免费版域名每次重启都变，所以一般不需要写死；要写就写通配符：
#   VITE_ALLOWED_HOSTS=.natappfree.cc
# VITE_ALLOWED_HOSTS=
