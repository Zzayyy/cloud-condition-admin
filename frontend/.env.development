# 开发环境
VITE_PORT=5173
# 后端服务地址（当前 backend 目录为空，接口实现后改这里即可）
VITE_API_TARGET=http://127.0.0.1:8000

# 演示数据开关：
#   true  = 直接用 src/api/mock/ 下的假数据渲染页面（后端未就绪时用来看效果）
#   false = 走真实接口；后端不可达时仍会自动降级并给出提示
# 后端接通后把这里改成 false 即可，页面代码不用动。
VITE_USE_MOCK=true

# 开发服务器的 Host 白名单（逗号分隔），给内网穿透用。
# 不填则用 vite.config.ts 里的默认值（常见穿透服务的通配符）。
# 以 "." 开头 = 匹配该域名本身 + 任意子域。
# natapp 免费版域名每次重启都变，所以一般不需要写死；要写就写通配符：
#   VITE_ALLOWED_HOSTS=.natappfree.cc
# VITE_ALLOWED_HOSTS=

